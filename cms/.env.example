# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# Public URL of this Strapi instance. Required in production so the admin
# panel and the URLs on uploaded media point at the right host.
# PUBLIC_URL=https://your-strapi-host.example.com

# ---------------------------------------------------------------------------
# Secrets
#
# Generate each of these with:  openssl rand -base64 32
# APP_KEYS takes a comma-separated pair. Never reuse the values from .env.
# ---------------------------------------------------------------------------
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ---------------------------------------------------------------------------
# Database
#
# Local development defaults to SQLite — no setup, no credentials.
#   DATABASE_CLIENT=sqlite
#
# Production uses the Neon Postgres database. Paste Neon's pooled connection
# string into DATABASE_URL and leave the individual DATABASE_* fields unset;
# the connection string supplies all of them.
#
# Neon requires TLS, so DATABASE_SSL must be true.
# ---------------------------------------------------------------------------
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Seeding
#
# On first boot against an empty database, Strapi creates the page's sections
# and groups so a fresh install already matches the design. Set to true to
# skip that.
# ---------------------------------------------------------------------------
# STRAPI_SKIP_SEED=true
