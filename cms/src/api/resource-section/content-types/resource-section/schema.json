{
  "kind": "collectionType",
  "collectionName": "resource_sections",
  "info": {
    "singularName": "resource-section",
    "pluralName": "resource-sections",
    "displayName": "Resource Section",
    "description": "A titled band of the onboarding resources page, e.g. \"Email Signatures\"."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "Sections render on the page in ascending order."
    },
    "groups": {
      "type": "component",
      "repeatable": true,
      "component": "resource.group"
    }
  }
}
