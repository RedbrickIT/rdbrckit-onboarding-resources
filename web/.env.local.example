# Base URL of the Strapi instance. No trailing slash.
#   local:      http://localhost:1337
#   production: https://your-strapi-host.example.com
STRAPI_URL=http://localhost:1337

# Read-only API token, created in the Strapi admin under
# Settings -> API Tokens -> Create new API Token (token type: Read-only).
#
# Server-only: this is read in a server component and never reaches the
# browser. Do NOT prefix it with NEXT_PUBLIC_.
STRAPI_API_TOKEN=

# Shared secret for the on-demand revalidation webhook, so a Strapi publish
# can refresh the site immediately instead of waiting out the 60s window.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
